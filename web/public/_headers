# Scripts and styles are allowed by each page's own <meta> policy, which carries the hashes of what
# Astro writes inline (astro.config.mjs). They stay out of this header: the browser applies both
# policies, and a script-src here would block those scripts. This one holds what a <meta> cannot.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The microphone, for the call to the restaurant, only on the three home pages that offer it; no frame gets it.
/
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()

/en/
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()

/es/
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()

# The dashboard works on each visitor's own restaurant: search engines leave it out.
/panel/*
  X-Robots-Tag: noindex, nofollow

/en/panel/*
  X-Robots-Tag: noindex, nofollow

/es/panel/*
  X-Robots-Tag: noindex, nofollow

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Migue Studio's icons, fixed: the one a browser asks for on its own, the one search engines take, and the one a
# phone puts on its home screen.
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon-96x96.png
  Cache-Control: public, max-age=31536000, immutable

/apple-icon.png
  Cache-Control: public, max-age=31536000, immutable

# Each film's name carries its version: a new cut gets a new name.
/media/*
  Cache-Control: public, max-age=31536000, immutable

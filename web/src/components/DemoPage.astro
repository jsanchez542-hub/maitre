---
import { formatDate, type Language } from 'maitre';
import { DEMO_EVENING_DATE, DEMO_RESTAURANT } from 'maitre/demo';
import { messagesFor } from '../i18n/messages';
import Page from '../layouts/Page.astro';
import { ServiceDay } from './ServiceDay';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const t = messagesFor(language);
const day = formatDate(DEMO_EVENING_DATE, language, DEMO_EVENING_DATE);
---

<Page language={language} title={t.page.title} description={t.page.description}>
  <div class="intro">
    <h1 class="title">{t.page.heading}</h1>
    <p class="lead">{t.page.lead(DEMO_RESTAURANT.name, day)}</p>
  </div>
  <section aria-label={t.service.region}>
    <ServiceDay client:load language={language} />
  </section>
</Page>

---
import '@fontsource/cutive-mono/latin-400.css';
import '../styles/site.css';
import type { Language } from 'maitre';
import { messagesFor } from '../i18n/messages';
import { HOME } from '../i18n/routes';
import Base from '../layouts/Base.astro';
import BarrelMark from './BarrelMark.astro';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const t = messagesFor(language).notFound;
---

<Base language={language} title={t.title} description={t.body} side="client" notFound>
  <div class="site">
    <main class="lost" id="main">
      <BarrelMark />
      <h1>{t.heading}</h1>
      <p>{t.body}</p>
      <a href={HOME[language]}>{t.back}</a>
    </main>
  </div>
</Base>

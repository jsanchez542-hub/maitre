# Copy to .env.local to run the voice agent on your machine; .env.local is never committed.
# In production the same names are set as secrets where the agent runs.

# LiveKit Cloud project: cloud.livekit.io, project settings, API keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The name the agent registers under at LiveKit. A developer's agent takes another one, such as maitre-voice-dev, with
# LIVEKIT_AGENT_NAME set to the same in the local Worker, so it never answers the public demo's calls.
# MAITRE_AGENT_NAME=maitre-voice

# The Maître Worker the agent talks to, and the token of its "agent" routes.
MAITRE_API_URL=http://127.0.0.1:8787
MAITRE_AGENT_TOKEN=

# Speech recognition and synthesis, as "provider:model[:voice]". By default Deepgram's Nova-3 and Cartesia's voices,
# with their own keys below; "inference:" sends either through LiveKit Inference instead, paid from the LiveKit
# project's credit. Nova-3 is used with LiveKit's turn detector; "deepgram:flux-general-multi" lets Flux decide the end
# of a turn instead.
# VOICE_STT=inference:deepgram/nova-3
# A voice for each language, from one provider: a synthesized voice speaks the one language it was made for.
# VOICE_TTS=inference:deepgram/aura-2:agathe
# VOICE_TTS_EN=inference:deepgram/aura-2:athena
# VOICE_TTS_ES=inference:deepgram/aura-2:carina

# With Flux only: how sure it must be that the caller has finished, and how long after their last word it decides anyway.
# VOICE_EOT_THRESHOLD=0.7
# VOICE_EOT_TIMEOUT_MS=3000

# Providers called directly ("deepgram:", "cartesia:", "elevenlabs:", "mistral:"): only the ones the agent is configured
# to use are needed. With the defaults, Deepgram's and Cartesia's.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
MISTRAL_API_KEY=
ELEVEN_API_KEY=

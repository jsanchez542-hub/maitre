# Copy to .env.local to run the voice agent on your machine; .env.local is never committed.
# In production the same names are set as secrets where the agent runs.

# LiveKit Cloud project: cloud.livekit.io, project settings, API keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The Maître Worker the agent talks to, and the token of its "agent" routes.
MAITRE_API_URL=http://127.0.0.1:8787
MAITRE_AGENT_TOKEN=

# Speech recognition and synthesis, as "provider:model[:voice]". The defaults go through LiveKit Inference,
# paid from the LiveKit project's credit, and need no other key. Nova-3 is used with LiveKit's turn detector;
# "inference:deepgram/flux-general-multi" lets Flux decide the end of a turn instead.
# VOICE_STT=inference:deepgram/nova-3
# VOICE_TTS=inference:deepgram/aura-2:agathe

# With Flux only: how sure it must be that the caller has finished, and how long after their last word it decides anyway.
# VOICE_EOT_THRESHOLD=0.7
# VOICE_EOT_TIMEOUT_MS=3000

# Providers called directly instead of through LiveKit Inference ("deepgram:", "cartesia:", "elevenlabs:", "mistral:"):
# only the ones the agent is configured to use are needed.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
MISTRAL_API_KEY=
ELEVEN_API_KEY=

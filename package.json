{
  "name": "maitre",
  "version": "0.1.0",
  "private": true,
  "description": "Booking assistant for restaurants and other appointment businesses: a deterministic booking engine with an AI that only does the talking",
  "author": "Miguel Sanchez Torres",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "import": "./dist/demo/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config vitest.evals.config.ts evals/run.eval.ts",
    "eval:rescore": "vitest run --config vitest.evals.config.ts evals/rescore.eval.ts",
    "eval:export": "vitest run --config vitest.evals.config.ts evals/export.eval.ts",
    "eval:providers": "vitest run --config vitest.evals.config.ts evals/providers.eval.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

# Copy to .dev.vars for `npm run dev`; .dev.vars is never committed.
# In production these are set with `wrangler secret put`, and DATA_JURISDICTION stays "eu" from wrangler.jsonc.

# workerd, which runs the local server, cannot pin data to a jurisdiction.
DATA_JURISDICTION=none

OPENROUTER_API_KEY=
AGENT_TOKEN=
STAFF_TOKEN=

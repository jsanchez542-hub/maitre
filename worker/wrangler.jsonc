{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maitre",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "RESTAURANTS", "class_name": "Restaurant" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Restaurant"] }],
  // The demo and dashboard pages, built by web/ (npm run build there) before a deploy.
  "assets": {
    "directory": "../web/dist",
    // An unknown address gets the nearest 404.html: under /en/, the English one.
    "not_found_handling": "404-page",
    // The API and the health check always reach the Worker, whatever the pages hold.
    "run_worker_first": ["/v1/*", "/health"]
  },
  "vars": {
    // Every restaurant's data stays in the EU. workerd cannot pin data, so
    // local runs override this with "none" in .dev.vars and the test config.
    "DATA_JURISDICTION": "eu",
    // Chosen with the evaluation (evals/RESULTS.md).
    "MODEL": "anthropic/claude-haiku-5.5",
    "RESTAURANT_IDS": "demo"
  }
  // Secrets, never in this file: OPENROUTER_API_KEY, AGENT_TOKEN and STAFF_TOKEN,
  // set with `wrangler secret put` in production and in .dev.vars locally.
}

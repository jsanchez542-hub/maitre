{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maitre",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // One public address: the site, the dashboard and the API at https://maitre.live. The workers.dev
  // address and preview URLs stay off, so nothing reaches the Worker around the domain's own rules.
  "routes": [{ "pattern": "maitre.live", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "RESTAURANTS", "class_name": "Restaurant" },
      // The public demo: a restaurant of its own for each visitor, and the one place its spending is kept.
      { "name": "DEMO_RESTAURANTS", "class_name": "DemoRestaurant" },
      { "name": "DEMO_BUDGET", "class_name": "DemoBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Restaurant"] },
    { "tag": "v2", "new_sqlite_classes": ["DemoRestaurant", "DemoBudget"] }
  ],
  // The demo and dashboard pages, built by web/ (npm run build there) before a deploy.
  "assets": {
    "directory": "../web/dist",
    // An unknown address gets the nearest 404.html: under /en/, the English one.
    "not_found_handling": "404-page",
    // The API and the health check always reach the Worker, whatever the pages hold. The demo's films
    // are pages' files like any other (web/public/media/), served with Range requests by the platform.
    "run_worker_first": ["/v1/*", "/health"]
  },
  // One address cannot use up the API for everyone: past 120 requests a minute it waits, so a
  // script cannot spend the day's requests that every visitor shares. The voice agent, which
  // speaks for many callers from one server, shows its token instead and is not counted.
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    // Every restaurant's data stays in the EU. workerd cannot pin data, so
    // local runs override this with "none" in .dev.vars and the test config.
    "DATA_JURISDICTION": "eu",
    // The model was chosen with the evaluation (evals/RESULTS.md, runs E, I and J), for the chat and
    // the phone. After the "@", its providers in order: the EU first, where the restaurant's data is,
    // and the fastest on the phone's own request (npm run eval:providers, 13 October: Vertex in Europe
    // ended a call in 0.77 s where "fastest now" routing took 1.13 s). One provider keeps the prompt
    // cache, which a provider that changes from call to call loses. Anthropic only if both EU ones fail.
    "MODEL": "anthropic/claude-haiku-5.5@google-vertex/europe,amazon-bedrock/eu-west-1,anthropic",
    "RESTAURANT_IDS": "demo",
    // The public demo's limits. A conversation costs about $0.002, so a dollar a day is some
    // 500 conversations; past a limit the demo pauses and says so. Its own OpenRouter key
    // carries a credit limit too, set at OpenRouter: a second ceiling if this count were wrong.
    "DEMO_DAILY_USD": "1",
    "DEMO_MONTHLY_USD": "10",
    "DEMO_SANDBOXES_PER_IP": "5",
    "DEMO_MESSAGES_PER_SANDBOX": "60",
    // Calls from the demo's browser: a few per restaurant, four minutes each, which is time
    // enough to book. A minute of voice is counted at what speech recognition, speech
    // synthesis and LiveKit cost at list price, even while free tiers pay for it, so the
    // daily and monthly limits above still hold the day they stop.
    "DEMO_CALLS_PER_SANDBOX": "3",
    "DEMO_CALL_SECONDS": "240",
    "DEMO_VOICE_USD_PER_MINUTE": "0.03",
    // The name the voice agent registers under at LiveKit (voice/).
    "LIVEKIT_AGENT_NAME": "maitre-voice"
  }
  // Secrets, never in this file: OPENROUTER_API_KEY, AGENT_TOKEN, STAFF_TOKEN,
  // DEMO_OPENROUTER_API_KEY, TURNSTILE_SECRET, and the LiveKit project's
  // LIVEKIT_URL, LIVEKIT_API_KEY and LIVEKIT_API_SECRET, set with
  // `wrangler secret put` in production and in .dev.vars locally.
}
